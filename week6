        "# ---------------------------------------\n",
        "# Role-Based Prompt\n",
        "# ---------------------------------------\n",
        "\n",
        "role_prompt = \"\"\"\n",
        "You are a financial advisor.\n",
        "\n",
        "Give five simple tips for saving money for college students.\n",
        "\"\"\"\n",
        "\n",
        "role_response = client.chat.completions.create(\n",
        "    model=\"llama-3.3-70b-versatile\",\n",
        "    messages=[\n",
        "        {\"role\": \"user\", \"content\": role_prompt}\n",
        "    ]\n",
        ")\n",
        "\n",
        "# ---------------------------------------\n",
        "# Negative Prompt\n",
        "# ---------------------------------------\n",
        "\n",
        "negative_prompt = \"\"\"\n",
        "You are a financial advisor.\n",
        "\n",
        "Give five simple tips for saving money for college students.\n",
        "\n",
        "Do not mention any bank names or brand names.\n",
        "\"\"\"\n",
        "\n",
        "negative_response = client.chat.completions.create(\n",
        "    model=\"llama-3.3-70b-versatile\",\n",
        "    messages=[\n",
        "        {\"role\": \"user\", \"content\": negative_prompt}\n",
        "    ]\n",
        ")\n",
        "\n",
        "# ---------------------------------------\n",
        "# Display Results\n",
        "# ---------------------------------------\n",
        "\n",
        "print(\"========== Role-Based Prompt ==========\\n\")\n",
        "print(role_prompt)\n",
        "\n",
        "print(\"\\nOutput:\\n\")\n",
        "print(role_response.choices[0].message.content)\n",
        "\n",
        "print(\"\\n\\n========== Negative Prompt ==========\\n\")\n",
        "print(negative_prompt)\n",
        "\n",
        "print(\"\\nOutput:\\n\")\n",
        "print(negative_response.choices[0].message.content)\n"
